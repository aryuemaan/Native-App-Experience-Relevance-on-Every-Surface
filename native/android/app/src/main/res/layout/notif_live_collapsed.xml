<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/collapsed_live"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_live_pill"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="@string/live"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/collapsed_teams"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Dinamo - Hajduk"
        android:textColor="#F5F6F7"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/collapsed_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="1:0"
        android:textColor="#F5F6F7"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/collapsed_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="18,90 EUR"
        android:textColor="#B8F84A"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
